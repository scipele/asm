{
  "name": "asm-runner-extension",
  "displayName": "ASM Runner",
  "description": "Build and run assembly files from VS Code on Linux.",
  "version": "0.0.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onCommand:asmRunner.buildCurrentFile",
    "onCommand:asmRunner.runCurrentFile"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "asmRunner.buildCurrentFile",
        "title": "ASM Runner: Build Current File"
      },
      {
        "command": "asmRunner.runCurrentFile",
        "title": "ASM Runner: Build && Run Current File"
      }
    ],
    "configuration": {
      "title": "ASM Runner",
      "properties": {
        "asmRunner.outputDirectory": {
          "type": "string",
          "default": "build",
          "description": "Directory name (relative to file folder) where object and binary files are written."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.4"
  }
}
